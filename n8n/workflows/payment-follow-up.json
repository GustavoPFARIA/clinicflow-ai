{
  "name": "ClinicFlow - Payment follow-up",
  "nodes": [
    {
      "id": "bd532b05-d487-4a08-8034-6df6cb9608d1",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -220
      ],
      "parameters": {
        "content": "## Payment follow-up\nBookings stay 'scheduled' until the Stripe webhook confirms payment. This nudges patients with the (reused, idempotent) Stripe checkout link.",
        "width": 520,
        "height": 160
      }
    },
    {
      "id": "b179cd21-40d3-4cfc-94e0-d0115663e909",
      "name": "Every 2 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "7c0bfca5-d586-4f4a-9a98-aa1ceba3d519",
      "name": "Get unpaid bookings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CLINICFLOW_API_URL }}/automations/payments/pending",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $env.CLINICFLOW_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "c6af4311-f59a-41fc-b570-c6025084a796",
      "name": "One item per booking",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "appointments",
        "options": {}
      }
    },
    {
      "id": "56b40f5a-6e12-49c9-adba-a9a84fa13497",
      "name": "Send payment nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLINICFLOW_API_URL }}/automations/payments/{{ $json.appointment_id }}/nudge",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $env.CLINICFLOW_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Every 2 hours": {
      "main": [
        [
          {
            "node": "Get unpaid bookings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get unpaid bookings": {
      "main": [
        [
          {
            "node": "One item per booking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per booking": {
      "main": [
        [
          {
            "node": "Send payment nudge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all"
  },
  "tags": [
    {
      "name": "clinicflow"
    }
  ]
}
