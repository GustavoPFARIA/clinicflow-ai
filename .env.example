# Everything is optional. With no keys every service falls back to a local implementation.

# "auto" uses the first key present (Anthropic, OpenAI, Gemini); offline policy if none.
# Free option: a Gemini key from https://aistudio.google.com/apikey (no card needed).
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Any OpenAI-compatible server (Ollama: http://localhost:11434/v1, Groq, OpenRouter...)
OPENAI_BASE_URL=

# Stripe (test mode). Without a key, a local demo checkout emits signed events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_demo_secret

# WhatsApp Cloud API. Without credentials, messages go to the in-app outbox.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=clinicflow-verify

# Shared secret between n8n and the API
AUTOMATION_TOKEN=dev-automation-token
SLACK_WEBHOOK_URL=
