# Everything is optional. With no keys the app runs fully offline in demo mode.

# LLM: "mock" (deterministic scripted policy) or "anthropic" (Claude)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe (test mode). Without a key, a local demo checkout emits signed events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_demo_secret

# WhatsApp Cloud API. Without credentials, messages go to the in-app outbox.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=clinicflow-verify

# Shared secret between n8n and the API
AUTOMATION_TOKEN=dev-automation-token
SLACK_WEBHOOK_URL=
